PORT=4000
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d
API_BASE_URL=http://localhost:4000
NODE_ENV=development
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

DB_HOST=localhost
DB_PORT=3307
DB_USER=eba_user
DB_PASSWORD=cambia_esta_password
DB_NAME=eba_db

# EBA Assistant (Google Gemini, solo backend, nunca VITE_)
GEMINI_API_KEY=pegue_aqui_su_clave
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_MAX_TOKENS=800
ASSISTANT_TIMEOUT_MS=25000
ASSISTANT_MAX_TOOL_CALLS=5

# Alternativas gratuitas verificadas hoy (si 3.5-flash-lite se agota):
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL=gemini-3.1-flash-lite
# Nota: gemini-2.5-flash ya no está disponible para usuarios nuevos (404, usa gemini-3.8-flash)

# Nota privacidad (nivel gratuito AI Studio): Google puede usar los datos para mejorar sus productos.
# No envíes datos personales, tokens ni información confidencial al asistente.

# Legacy OpenAI (no usar hasta que se confirme Gemini; se mantiene para rollback)
OPENAI_API_KEY=pegue_aqui_su_clave_openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
